# ============================================================
# TBS II - Environment Configuration Template
# Copy to .env and fill in secure values for production
# ============================================================

# --- Database ---
DATABASE_URL=sqlite:///./tbs2_factory.db

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-secure-random-value-at-least-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_HOURS=24

# --- PLC Telemetry API Key ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLC_API_KEY=change-me-to-a-secure-random-value

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# --- Rate Limiting ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=10
LOGIN_RATE_WINDOW_SECONDS=60
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=30

# --- Password Policy ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# --- HTTPS / HSTS (bật true khi chạy production sau reverse proxy) ---
BEHIND_PROXY=false
HSTS_MAX_AGE=31536000

# --- Grok AI (xAI) Chat API ---
# Get free API key at: https://console.x.ai
GROK_API_KEY=

# --- Debug ---
DEBUG=false
