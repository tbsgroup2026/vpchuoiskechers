    "chart.js": "^4.4.4",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "hono": "^4.13.13",
    "jose": "^5.9.3",
    "jszip": "^3.10.2",
    "next": "14.2.15",
    "pizzip": "^3.3.0",
    "postcss": "^8.5.26",
    "puppeteer": "^25.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
