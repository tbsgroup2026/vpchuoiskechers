{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vpchuoiskechers",
  "account_id": "3b346f8398b8d1143acd52516011cfb4",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vpchuoiskechers",
      "database_id": "ae3a7efd-ff5d-45c2-8c49-78d1518e3aa1"
    }
  ],
  "assets": {
    "directory": "out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://vpchuoiskechers.tbsgroup2026.workers.dev",
    "JWT_SECRET": "tbs_group_secure_jwt_secret_key_2026"
  },
  "triggers": {
    "crons": [
      "0 8 * * 1"
    ]
  }
}
