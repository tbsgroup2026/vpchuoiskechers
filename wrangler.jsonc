{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vpchuoiskechers",
  "main": "web/worker/index.js",
  "account_id": "3b346f8398b8d1143acd52516011cfb4",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "web/out",
    "binding": "ASSET_BINDING",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "SITE_ID": "vpchuoiskechers",
    "CLOUDINARY_FOLDER": "vpchuoiskechers",
    "NEXT_PUBLIC_APP_URL": "https://vpchuoiskechers.tbsgroup2026.workers.dev",
    "TBSMAYMOC_API_URL": "https://tbs-may-moc-admin.tbs-quanlymaymoc.workers.dev",
    "MMTB_AUTO_LOGIN_EMP_CODE": "AMDKG",
    "VAPID_PUBLIC_KEY": "BO2jkziEEK_t-ex0cLOzysw45I0mm2_g6iwA1CsdDep9nAoDVYmlqTjep7rHWtC-OHu8JWDQr-Ugh7LQMRGbc44",
    "VAPID_CONTACT": "mailto:admin@tbsgroup.vn",
    "GDRIVE_CLIENT_EMAIL": "tbs-backup-sa@photocloudapp-465001.iam.gserviceaccount.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vpchuoiskechers-db",
      "database_id": "ae3a7efd-ff5d-45c2-8c49-78d1518e3aa1",
      "migrations_dir": "web/migrations"
    },
    {
      "binding": "DB_KG",
      "database_name": "thkiengiangshoes",
      "database_id": "176450d4-b81b-40d0-aee6-071ce67a626f",
      "migrations_dir": "web/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tbs-business-trips"
    },
    {
      "binding": "IMAGE_BUCKET",
      "bucket_name": "tbs-img"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 * * * *",
      "0 19 * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "vpchuoiskechers-staging",
      "workers_dev": true,
      "assets": {
        "directory": "web/out",
        "binding": "ASSET_BINDING",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": true
      },
      "vars": {
        "SITE_ID": "vpchuoiskechers-staging",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vpchuoiskechers-hr-staging",
          "database_id": "89923c1d-4f4c-446d-8393-7b4cd7efd994"
        },
        {
          "binding": "DB_KG",
          "database_name": "thkiengiangshoes-staging",
          "database_id": "89923c1d-4f4c-446d-8393-7b4cd7efd994"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "tbs-hr-staging"
        },
        {
          "binding": "IMAGE_BUCKET",
          "bucket_name": "tbs-hr-staging"
        }
      ],
      "triggers": { "crons": [] }
    }
  }
}
